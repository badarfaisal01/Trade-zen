# ==============================================================================
# 55AK Trade Platform - Example Environment Template
# Duplicate this file to .env and configure for your environment.
# ==============================================================================

# 1. APPLICATION SETTINGS
APP_NAME="55AK Trade"
APP_TAGLINE="Smart market trading platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://trading.yourdomain.com
APP_TIMEZONE=Asia/Kolkata
APP_VERSION=4.5.0
TRUST_CLOUDFLARE_IP_HEADER=false

# 2. DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tradingapp
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4

# 3. MAIL CONFIGURATION (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="55AK Trade"

# 4. MARKET DATA & EXCHANGE APIS
MARKET_API_PROVIDER=binance
BINANCE_API_KEY=your_binance_api_key_optional
BINANCE_QUOTE_TTL_MS=1500
BINANCE_KLINE_TTL_MS=3000
FINNHUB_API_KEY=your_finnhub_api_key
TWELVEDATA_API_KEY=your_twelvedata_api_key
METALS_API_KEY=your_metals_api_key

# 5. PAYMENT GATEWAYS
STRIPE_KEY=your_stripe_publishable_key
STRIPE_SECRET=your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# 6. SESSION & CACHING
SESSION_NAME=TRADE55AK
SESSION_LIFETIME=120
CACHE_DRIVER=file
CACHE_TTL=3600

# 7. ADMINISTRATOR PANEL
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password

# 8. TRADING DEFAULTS
REFERRAL_COMMISSION=0.10
DEMO_STARTING_BALANCE=0
PRACTICE_STARTING_BALANCE=1000
MINIMUM_TRADE_AMOUNT=1
MAXIMUM_TRADE_AMOUNT=1000
DEFAULT_CURRENCY=USD

# 9. SECURITY
SECRET_KEY=your_random_64_character_encryption_secret
